load("@rules_oci//oci:defs.bzl", "oci_load")
load("@svetoch_bazel_lib//tools/macros:img.bzl", "img_push")
load("@svetoch_bazel_lib//tools/utils:common.bzl", "app_envs")

#bazel run :spilo_docker
#docker run --rm -it spilo:17
oci_load(
    name = "spilo_docker",
    image = "@svetoch_bazel_lib//deps/images/postgres/spilo/17:spilo_img",
    repo_tags = [
        "spilo:17",
    ],
)

img_push(
    envs = app_envs().keys(),
    image = "@svetoch_bazel_lib//deps/images/postgres/spilo/17:spilo_img",
    remote_tags = "image_tag.txt",
    service_name = "spilo",
)
