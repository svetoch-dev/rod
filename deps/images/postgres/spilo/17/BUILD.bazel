load("@aspect_bazel_lib//lib:tar.bzl", "mtree_mutate", "mtree_spec", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@svetoch_bazel_lib//tools/macros:img.bzl", "img_push")
load("@svetoch_bazel_lib//tools/utils:common.bzl", "app_envs")

mtree_spec(
    name = "mtree",
    srcs = ["scripts/clone_with_wale.py"],
)

mtree_mutate(
    name = "strip_package",
    mtree = "mtree",
    strip_prefix = package_name(),
)

tar(
    name = "clone_with_wale",
    srcs = ["scripts/clone_with_wale.py"],
    mtree = "strip_package",
)

oci_image(
    name = "spilo_img",
    base = "@spilo17",
    tars = [
        ":clone_with_wale",
    ],
)

#bazel run :spilo_docker
#docker run --rm -it spilo:17
oci_load(
    name = "spilo_docker",
    image = ":spilo_img",
    repo_tags = [
        "spilo:17",
    ],
)

img_push(
    envs = app_envs().keys(),
    image = "spilo_img",
    remote_tags = "image_tag.txt",
    service_name = "spilo",
)
