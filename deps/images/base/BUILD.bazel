load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_distroless//distroless:defs.bzl", "cacerts", "group", "passwd")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//tools/macros:deb_packages.bzl", "deb_packages")

cacerts(
    name = "ca",
    package = "@ca-certificates//:data.tar.zst",
)

passwd(
    name = "passwd",
    entries = [
        {
            "uid": 0,
            "gid": 0,
            "home": "/root",
            "shell": "/bin/bash",
            "username": "root",
        },
        {
            "uid": 100,
            "gid": 65534,
            "home": "/home/_apt",
            "shell": "/usr/sbin/nologin",
            "username": "_apt",
        },
        {
            "uid": 1000,
            "gid": 1000,
            "home": "/home/ubuntu",
            "shell": "/bin/bash",
            "username": "ubuntu",
        },
    ],
)

group(
    name = "group",
    entries = [
        {
            "name": "root",
            "gid": 0,
        },
        {
            "name": "_apt",
            "gid": 65534,
        },
        {
            "name": "ubuntu",
            "gid": 1000,
        },
    ],
)

tar(
    name = "sh_homedir",
    mtree = [
        # needed as dpkg assumes sh is installed in a typical debian installation.
        "./usr/bin/sh type=link link=/usr/bin/bash",
        "./home/ubuntu/ uid=1000 gid=0 mode=0755 type=dir",
    ],
)

PACKAGES = [
    "@noble//ncurses-base",
    "@noble//libncurses6",
    "@noble//tzdata",
    "@noble//bash",
    "@noble//coreutils",
    "@noble//dpkg",
    "@noble//grep",
    "@noble//apt",
    "@noble//perl",
]

_packages_tar = deb_packages(PACKAGES)

oci_image(
    name = "ubuntu_noble",
    architecture = "amd64",
    entrypoint = ["/bin/bash"],
    env = {
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
    },
    os = "linux",
    tars = [
        ":sh_homedir",
        ":passwd",
        ":group",
        ":ca",
        _packages_tar,
    ],
    visibility = ["//visibility:public"],
)

#bazel run :ubuntu_noble_tarball
#docker run --rm -it ubuntu_noble:latest
oci_load(
    name = "ubuntu_noble_tarball",
    image = ":ubuntu_noble",
    repo_tags = [
        "ubuntu_noble:latest",
    ],
)
