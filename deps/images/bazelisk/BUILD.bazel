load("@rules_oci//oci:defs.bzl", "oci_load")
load("@svetoch_bazel_lib//tools/macros:img.bzl", "img_push")

#bazel run :bazelisk_docker
#docker run --rm -it bazelisk:latest
oci_load(
    name = "bazelisk_docker",
    image = "@svetoch_bazel_lib//deps/images/bazelisk:bazelisk_img",
    repo_tags = [
        "bazelisk:latest",
    ],
)

img_push(
    envs = ["int"],
    image = "@svetoch_bazel_lib//deps/images/bazelisk:bazelisk_img",
    remote_tags = "image_tag.txt",
    service_name = "bazelisk",
)
