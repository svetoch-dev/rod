{
  "company": {
    "domain": "rod.svetoch.dev",
    "name": "rod"
  },
  "ci": {
    "type": "gha",
    "bazelisk_img_version": ""
  },
  "repo": {
    "type": "github",
    "name": "infrastructure",
    "group": "svetoch-dev"
  },
  "envs": {
    "internal": {
      "name": "internal",
      "short_name": "int",
      "type": "internal",
      "initial_start": "true",
      "users": {},
      "apps": {},
      "import_secrets": {
        "redis": {
          "name": "argocd-redis",
          "namespace": "argocd",
          "secrets_to_import": [
            "password", "redis-password"
          ]
        },
        "alertmanager": {
          "name": "alertmanager",
          "namespace": "prometheus",
          "secrets_to_import": [
            "receiver-secret"
          ]
        },
        "sso": {
          "name": "sso",
          "namespace": "pomerium",
          "secrets_to_import": [
            "client_id",
            "client_secret"
          ]
        }
      },
      "tf_backend": {
        "type": "gcs",
        "configs": {
          "bucket": "{company.name}-tf-state",
          "prefix": "{env.name}/{tf_backend.state_name}"
        }
      },
      "registry": {
        "type": "gar",
        "url": "{env.cloud.location.region}-docker.pkg.dev/{env.cloud.id}/containers"
      },
      "dns": {
        "domain": "{env.short_name}.{company.domain}.",
        "type": "gcp"
      },
      "cloud": {
        "name": "gcp",
        "id": "rod-internal",
        "location": {
          "region": "europe-west2",
          "default_zone": "europe-west2-c",
          "multi_region": "EU"
        },
        "network": {
          "vm_cidr": "",
          "k8s_pod_cidr": "",
          "k8s_service_cidr": ""
        },
        "buckets": {
          "multi_regional": "false"
        }
      },
      "kubernetes": {
        "enabled": "true",
        "regional": "false",
        "node_locations": [
          "europe-west2-a"
        ]
      }
    },
    "product": {
      "name": "product",
      "short_name": "prdct",
      "type": "product",
      "initial_start": "true",
      "users": {},
      "apps": {
        "example": {
          "name": "example",
          "postgres": "true",
          "redis": "true",
          "rabbitmq": "true",
          "repo": {
            "name": "example"
          },
          "cd": {
            "branch": "master",
            "file": "argocd/environments/gcp-prdct/example/values.yaml",
            "tag_path": ".global.image.tag"
          }
        }
      },
      "import_secrets": {
        "alertmanager": {
          "name": "alertmanager",
          "namespace": "prometheus",
          "secrets_to_import": [
            "receiver-secret"
          ]
        },
        "sso": {
          "name": "sso",
          "namespace": "pomerium",
          "secrets_to_import": [
            "client_id",
            "client_secret"
          ]
        }
      },
      "tf_backend": {
        "type": "gcs",
        "configs": {
          "bucket": "{company.name}-tf-state",
          "prefix": "{env.name}/{tf_backend.state_name}"
        }
      },
      "registry": {
        "type": "gar",
        "url": "{env.cloud.location.region}-docker.pkg.dev/{env.cloud.id}/containers"
      },
      "dns": {
        "domain": "{env.short_name}.{company.domain}.",
        "type": "gcp"
      },
      "cloud": {
        "name": "gcp",
        "id": "rod-production",
        "location": {
          "region": "europe-west2",
          "default_zone": "europe-west2-c",
          "multi_region": "EU"
        },
        "network": {
          "vm_cidr": "",
          "k8s_pod_cidr": "",
          "k8s_service_cidr": ""
        },
        "buckets": {
          "multi_regional": "false"
        }
      },
      "kubernetes": {
        "enabled": "true",
        "regional": "true",
        "node_locations": [
          "europe-west2-a"
        ]
      }
    }
  }
}
