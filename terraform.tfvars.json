{
  "company": {
    "domain": "svetoch.dev",
    "name": "svetoch"
  },
  "ci": {
    "type": "gha",
    "group": "svetoch-dev",
    "bazelisk_img_version": ""
  },
  "repo": {
    "type": "github",
    "name": "infrastructure",
    "group": "svetoch-dev"
  },
  "envs": {
    "internal": {
      "name": "internal",
      "short_name": "int",
      "initial_start": "true",
      "users": {},
      "apps": {},
      "import_secrets": {
        "redis": {
          "name": "argocd-redis",
          "namespace": "argocd",
          "secrets_to_import": [
            "password", "redis-password"
          ]
        },
        "alertmanager": {
          "name": "alertmanager",
          "namespace": "prometheus",
          "secrets_to_import": [
            "receiver-secret"
          ]
        },
        "sso": {
          "name": "sso",
          "namespace": "pomerium",
          "secrets_to_import": [
            "client_id",
            "client_secret"
          ]
        }
      },
      "tf_backend": {
        "type": "s3",
        "configs": {
          "bucket": "{company.name}-tf-state",
          "use_lockfile": "true",
          "region": "{env.cloud.region}",
          "key": "{env.name}/{tf_backend.state_name}/default.tfstate",
          "skip_region_validation": "true",
          "skip_credentials_validation": "true",
          "skip_requesting_account_id": "true",
          "skip_s3_checksum": "true"
        }
      },
      "cloud": {
        "name": "yc",
        "id": "b1grv6akrivi20i4ahdj",
        "region": "ru-central1",
        "default_zone": "ru-central1-a",
        "multi_region": "",
        "folder_id": "b1gfu8oas3od212hedtu",
        "network": {
          "vm_cidr": "10.0.0.0/20",
          "k8s_pod_cidr": "10.4.0.0/14",
          "k8s_service_cidr": "10.1.0.0/20"
        },
        "registry": "{env.cloud.region}-docker.pkg.dev/{env.cloud.id}/containers",
        "buckets": {
          "multi_regional": "false"
        }
      },
      "kubernetes": {
        "enabled": "true",
        "regional": "false",
        "node_locations": [
          "europe-west2-a"
        ]
      }
    },
    "template": {
      "name": "template",
      "short_name": "tpl",
      "initial_start": "true",
      "users": {},
      "apps": {
        "example": {
          "name": "example",
          "postgres": "true",
          "redis": "true",
          "rabbitmq": "true"
        }
      },
      "import_secrets": {
        "alertmanager": {
          "name": "alertmanager",
          "namespace": "prometheus",
          "secrets_to_import": [
            "receiver-secret"
          ]
        },
        "sso": {
          "name": "sso",
          "namespace": "pomerium",
          "secrets_to_import": [
            "client_id",
            "client_secret"
          ]
        }
      },
      "tf_backend": {
        "type": "gcs",
        "configs": {
          "bucket": "{company.name}-tf-state",
          "prefix": "{env.name}/{tf_backend.state_name}"
        }
      },
      "cloud": {
        "name": "gcp",
        "id": "rod-production",
        "region": "europe-west2",
        "default_zone": "europe-west2-c",
        "multi_region": "EU",
        "network": {
          "vm_cidr": "10.8.0.0/20",
          "k8s_pod_cidr": "10.12.0.0/14",
          "k8s_service_cidr": "10.9.0.0/20"
        },
        "registry": "{env.cloud.region}-docker.pkg.dev/{env.cloud.id}/containers",
        "buckets": {
          "multi_regional": "false"
        }
      },
      "kubernetes": {
        "enabled": "true",
        "regional": "true",
        "node_locations": [
          "europe-west2-a"
        ]
      }
    }
  }
}
