load("@rules_multirun//:defs.bzl", "command", "multirun")
load("@aspect_rules_py//py:defs.bzl", "py_binary")

py_binary(
    name = "prepare",
    srcs = ["prepare.py"],
    visibility = ["//visibility:public"],
)

command(
    name = "init_prepare",
    command = ":prepare",
)

command(
    name = "tf_init",
    command = "//scripts/init/tf:init",
)

command(
    name = "images_init",
    command = "//scripts/init/images:init",
)

multirun(
    name = "init",
    commands = [
        "init_prepare",
        "tf_init",
        "images_init",
    ],
)
