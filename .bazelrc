#try import bazelrc for ci where cache is defined
try-import %workspace%/.bazelrc.ci
#try-import cloud related configs
try-import %workspace%/.bazelrc.cloud

#Needed for in order to use basic auth proxies
startup --host_jvm_args="-Djdk.http.auth.tunneling.disabledSchemes="
common --@aspect_rules_py//py:emit_rules_python_providers
test --test_output=errors
build --action_env https_proxy --workspace_status_command=scripts/stamping/update_status.sh
build --action_env GITHUB_TOKEN
common --repo_env=https_proxy
common --repo_env=DO_NOT_TRACK=1
