{
  "company": {
    "domain": "infrared.by",
    "name": "infrared"
  },
  "github": {
    "org": "ggramal" 
  },
  "tf_backend": {
    "type": "gcs",
    "configs": {
      "bucket": "{company_name}-tf-state",
      "prefix": "{env_name}/{state_name}"
    }
  },
  "envs": {
    "internal": {
      "name": "internal",
      "short_name": "int",
      "cloud": {
        "name": "gcp",
        "id": "infrared-internal",
        "region": "europe-west2",
        "default_zone": "europe-west2-b",
        "multi_region": "EU"
      },
      "kubernetes": {
        "regional": true,
        "location": "europe-west2",
        "auth_group": "gke-security-groups@infrared.dev"
      }
    },
    "development": {
      "name": "development",
      "short_name": "dev",
      "cloud": {
        "name": "gcp",
        "id": "infrared-development",
        "region": "europe-west2",
        "default_zone": "europe-west2-a",
        "multi_region": "EU"
      },
      "kubernetes": {
        "regional": false,
        "location": "europe-west2-a",
        "auth_group": "gke-security-groups@infrared.dev"
      }
    },
    "production": {
      "name": "production",
      "short_name": "prd",
      "cloud": {
        "name": "gcp",
        "id": "infrared-production",
        "region": "europe-west2",
        "default_zone": "europe-west2-c",
        "multi_region": "EU"
      },
      "kubernetes": {
        "regional": true,
        "location": "europe-west2",
        "auth_group": "gke-security-groups@infrared.dev"
      }
    }
  }
}
