{
  "company": {
    "domain": "infrared.by",
    "name": "infrared"
  },
  "ci": {
    "type": "github",
    "group": "ggramal"
  },
  "envs": {
    "internal": {
      "name": "internal",
      "short_name": "int",
      "tf_backend": {
        "type": "gcs",
        "configs": {
          "bucket": "{company.name}-tf-state",
          "prefix": "{env.name}/{tf_backend.state_name}"
        }
      },
      "cloud": {
        "name": "gcp",
        "id": "infrared-internal",
        "region": "europe-west2",
        "registry": "{env.cloud.region}-docker.pkg.dev/{env.cloud.id}/containers",
        "default_zone": "europe-west2-b",
        "buckets": {
            "deletion_protection": "true"
        },
        "multi_region": "EU"
      },
      "kubernetes": {
        "regional": "true",
        "location": "europe-west2",
        "deletion_protection": "true",
        "auth_group": "gke-security-groups@infrared.by"
      }
    },
    "development": {
      "name": "development",
      "short_name": "dev",
      "tf_backend": {
        "type": "gcs",
        "configs": {
          "bucket": "{company.name}-tf-state",
          "prefix": "{env.name}/{tf_backend.state_name}"
        }
      },
      "cloud": {
        "name": "gcp",
        "id": "infrared-development",
        "region": "europe-west2",
        "registry": "{env.cloud.region}-docker.pkg.dev/{env.cloud.id}/containers",
        "default_zone": "europe-west2-a",
        "buckets": {
            "deletion_protection": "true"
        },
        "multi_region": "EU"
      },
      "kubernetes": {
        "regional": "false",
        "location": "europe-west2-a",
        "deletion_protection": "true",
        "auth_group": "gke-security-groups@infrared.by"
      }
    },
    "production": {
      "name": "production",
      "short_name": "prd",
      "tf_backend": {
        "type": "gcs",
        "configs": {
          "bucket": "{company.name}-tf-state",
          "prefix": "{env.name}/{tf_backend.state_name}"
        }
      },
      "cloud": {
        "name": "gcp",
        "id": "infrared-production",
        "region": "europe-west2",
        "registry": "{env.cloud.region}-docker.pkg.dev/{env.cloud.id}/containers",
        "default_zone": "europe-west2-c",
        "buckets": {
            "deletion_protection": "true"
        },
        "multi_region": "EU"
      },
      "kubernetes": {
        "regional": "true",
        "deletion_protection": "true",
        "location": "europe-west2",
        "auth_group": "gke-security-groups@infrared.by"
      }
    }
  }
}
